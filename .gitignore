__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.env
.DS_Store

# Large intermediates - rebuildable with `python run_pipeline.py`
data/raw/
data/processed/
data/benchmarks/
artifacts/embeddings/
artifacts/nlp/post_embeddings.npy
*.gexf

# The CSV export is 37 MB and fully rebuildable from app_data/ with
# `python -m src.features.export_csv`. The dictionary and manifest are small
# and ARE committed, because they are documentation rather than data.
data/csv/*.csv
!data/csv/DATA_DICTIONARY.csv
!data/csv/MANIFEST.csv

# app_data/ is INTENTIONALLY committed - it is the deployment payload.

# The real dataset is fetched and digest-verified by
# `python -m src.realdata.train_news`; the provenance record is committed, the
# 24 MB of raw articles are not.
data/real/*.csv
